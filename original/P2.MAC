	.Z80

	ORG	0FE00H

LFE00:	JP	LFE09
LFE03:	DW	00H		; Inicio del bloque
LFE05:	DW	00H		; Cantidad a sumar
LFE07:	DW	00H		; Suma de control
LFE09:	LD	A,20H
	OUT	(00H),A
	LD	SP,0000H
	LD	HL,LFE86
	LD	DE,0FE00H - 0007H
	LD	BC,0007H
	LDIR
	CALL	LFE38
	JR	Z,LFE29
	CALL	LFE58
	CALL	LFE38
	JR	NZ,LFE29
	INC	A
LFE29:	CALL	LFE8D
	LD	HL,(LFE03)
	INC	HL
	INC	HL
	INC	HL
	PUSH	HL
	INC	A
	RET	NZ

LFE35:	HALT
	JR	LFE35
LFE38:	LD	HL,(LFE03)
	LD	BC,(LFE05)
	LD	DE,0000H
LFE42:	LD	A,(HL)
	ADD	A,E
	LD	E,A
	LD	A,D
	ADC	A,00H
	LD	D,A
	INC	HL
	DEC	BC
	LD	A,C
	OR	B
	JR	NZ,LFE42
	LD	HL,(LFE07)
	XOR	A
	SBC	HL,DE
	RET	Z

	DEC	A
	RET

LFE58:	LD	HL,0200H
	LD	DE,(LFE03)
	LD	BC,(LFE05)

LFE63:	CALL	LFE6F
	LD	(DE),A
	INC	HL
	INC	DE
	DEC	BC
	LD	A,C
	OR	B
	JR	NZ,LFE63
	RET

LFE6F:	PUSH	HL
	LD	A,H
	RRCA
	AND	03H
	OR	20H
	EX	AF,AF'
	LD	A,H
	AND	01H
	OR	0FEH
	LD	H,A
	LD	A,20H
	EX	AF,AF'
	CALL	LFDF9
	EX	AF,AF'
	POP	HL
	RET

	.DEPHASE	0FE00H - 7

LFE86:	OUT	(00H),A
	LD	A,(HL)
	EX	AF,AF'
	OUT	(00H),A
	RET

	.PHASE

LFE8D:	LD	C,A
LFE8E:	IN	A,(20H)
	RLA
	JR	NC,LFE8E
	LD	A,C
	OUT	(10H),A
	RET

	END
