	.Z80

	ORG	0FE00H

LFE00:	JP	LFE03
LFE03:	LD	A,20H
	OUT	(00H),A
	LD	SP,0000H
	LD	HL,LFE52
	LD	DE,0FE00H - 0009H
	LD	BC,0009H
	LDIR
	CALL	LFE5B
	LD	L,A
	CALL	LFE5B
	LD	H,A
	PUSH	HL
	LD	BC,0FFFAH
LFE21:	CALL	LFE5B
	JR	C,LFE2B
	LD	(HL),A
	INC	HL
	INC	BC
	JR	LFE21
LFE2B:	POP	DE
	PUSH	DE
	INC	DE
	INC	DE
	INC	DE
	INC	DE
	INC	DE
	INC	DE
	LD	HL,0200H
LFE36:	PUSH	HL
	LD	A,H
	RRCA
	AND	03H
	OR	20H
	EX	AF,AF'
	LD	A,H
	AND	01H
	OR	0FEH
	LD	H,A
	LD	A,(DE)
	EX	AF,AF'
	CALL	LFDF7
	POP	HL
	INC	HL
	INC	DE
	DEC	BC
	LD	A,C
	OR	B
	JR	NZ,LFE36
	RET

	.DEPHASE	0FE00H - 0009H

LFE52:	OUT	(00H),A
	EX	AF,AF'
	LD	(HL),A
	LD	A,20H
	OUT	(00H),A
	RET

	.PHASE

LFE5B:	CALL	LFE6C
	CP	0F8H
	JR	NZ,LFE6A
	CALL	LFE6C
	OR	A
	SCF
	RET	NZ
	LD	A,0F8H
LFE6A:	OR	A
	RET

LFE6C:	IN	A,(20H)
	RLA
	RLA
	JR	NC,LFE6C
	IN	A,(10H)
	RET

	END
